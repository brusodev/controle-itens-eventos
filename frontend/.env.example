# Copie para .env.local e ajuste os valores.
#
# Em desenvolvimento, o proxy do próprio Next (ver next.config.ts) encaminha
# /api/* e /auth/* para o Flask em localhost:5100 — não defina uma URL de API
# aqui para o client fazer fetch (nada de NEXT_PUBLIC_API_URL com fallback
# hardcoded; o wrapper de API sempre usa caminho relativo, same-origin).

# URL pública do próprio frontend (usada em metadados, links absolutos etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alvo do proxy de desenvolvimento (rewrites em next.config.ts) — o Flask local.
BACKEND_URL=http://localhost:5100
