# Copie para .env.local e ajuste os valores.
#
# O client NUNCA usa URL absoluta de API: todo fetch é caminho relativo
# (/api/*, /auth/*), atendido pelo proxy do Next (rewrites em next.config.ts).
# Isso vale em dev E em produção — mantém tudo same-origin, então o cookie de
# sessão (HttpOnly, SameSite=Lax) funciona sem CORS e sem SESSION_COOKIE_DOMAIN.
# Por isso não existe NEXT_PUBLIC_API_URL aqui: seria um fallback hardcoded
# esperando para divergir.

# URL pública do próprio frontend (usada em metadados, links absolutos etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alvo do proxy — o Flask. É OBRIGATÓRIA: sem ela o build falha de propósito,
# porque um endereço adivinhado transformaria todo /api/* em 404 do próprio
# Next, e o site só quebraria no primeiro login, já em produção.
#
#   Local:  http://localhost:5100
#   Vercel: defina em Settings > Environment Variables (Production, Preview e
#           Development) apontando para o Flask publicado, ex.:
#           https://coex.projtdev.site
BACKEND_URL=http://localhost:5100
